{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "tests/**/*.test.ts",
    "tests/support/**/*.ts",
    "tests/browser/**/*.ts"
  ],
  "exclude": ["tests/e2e/**"]
}
