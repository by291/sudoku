{
  "name": "sudoku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm wasm:build && vite --host 127.0.0.1",
    "typecheck": "pnpm wasm:build && vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rust": "cargo test --workspace --locked",
    "test:unit": "pnpm wasm:build && vitest run",
    "build": "pnpm wasm:build && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:subpath": "pnpm wasm:build && vite build --base /sudoku/ --outDir dist-subpath",
    "test:e2e": "playwright test",
    "check": "pnpm test:rust && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit && pnpm build && pnpm test:e2e",
    "wasm:build": "node scripts/build-sudoku-wasm.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "@sudoku/wasm": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
